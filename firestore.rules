rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // CODEVERSE ACADEMY - FIRESTORE SECURITY RULES
    // =========================================================================
    // Note: User authentication (Google OAuth 2.0 ID Token verification),
    // Super-Admin privileges, Role-Based Access Control (RBAC), and Blocklist enforcement
    // are securely performed server-side inside the Next.js API Route (/api/codeverse).

    // 1. Users collection: Stores cadet profiles, roles, and progression
    match /users/{userEmail} {
      allow read, write: if true;
    }

    // 2. Blocked emails collection: Stores banned/removed cadet emails
    match /blocked_emails/{userEmail} {
      allow read, write: if true;
    }

    // 3. Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
