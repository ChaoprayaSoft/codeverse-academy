rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    
    // Checks if the user is authenticated via Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Checks if the user is the designated Super Administrator
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email == 'tiawongsombat@gmail.com';
    }

    // Checks if the authenticated user's email matches the document ID (email)
    function isOwner(userEmail) {
      return isAuthenticated() && (request.auth.token.email == userEmail || isSuperAdmin());
    }
    
    // Checks if the requesting user has the Admin role
    function isAdmin() {
      return isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.token.admin == true ||
          get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'Admin'
        )
      );
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    // 1. Users Collection (/users/{userEmail})
    // - Document ID is the user's lowercase email.
    // - Cadets can read/update their own profile & progress.
    // - Cadets can select Teacher, Student, or Guest roles during onboarding.
    // - Only Admins and Super Admins can manage roles and view all users.
    match /users/{userEmail} {
      allow read: if isOwner(userEmail) || isAdmin();
      
      // Allow new user creation with legitimate role options
      allow create: if (isOwner(userEmail) && (
        !request.resource.data.keys().hasAny(['role']) ||
        request.resource.data.role == 'Teacher' ||
        request.resource.data.role == 'Student' ||
        request.resource.data.role == 'Guest' ||
        request.resource.data.role == '' ||
        isAdmin()
      )) || isAdmin();
      
      // Allow user updates while preventing unauthorized role escalation to Admin
      allow update: if (
        isOwner(userEmail) && (
          request.resource.data.role == resource.data.role ||
          isAdmin()
        )
      ) || isAdmin();
      
      // Only Admins can delete users
      allow delete: if isAdmin();
    }

    // 2. Blocked Emails Collection (/blocked_emails/{userEmail})
    // - Only Admins can add or remove blocked emails.
    // - Authenticated users can read to verify account standing.
    match /blocked_emails/{userEmail} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // DEFAULT DENY
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
